[Desktop Entry]
# Version of the Desktop Entry Specification
Version=1.5
Name=Back In Time
GenericName=Versioned Backups
Exec=backintime-qt
Icon=backintime
Terminal=false
Type=Application
StartupNotify=true
# See Desktop Menu Specification
Categories=Utility;System;Archiving;Qt;
# Limit comments to 80 chars (Not in Desktop Entry Spec but Debian Lintian)   80th char --> |
Comment=User-friendly GUI for versioned backups that reduces disk usage
Keywords=backup;incremental;automatic;restore;rsync;
GenericName[zh_CN]=版本化备份
GenericName[et]=Versioonidega varukoopiad
GenericName[nl]=Versie-beheerde Back-ups
GenericName[sl]=Verzijske varnostne kopije
GenericName[gl]=Copias de seguranza versionadas
GenericName[pl]=Wersjonowane kopie zapasowe
GenericName[cs]=Verzované zálohy
GenericName[de]=Versionierte Sicherungen
GenericName[ro]=Copii de rezervă cu versiuni
GenericName[tr]=Sürümlü Yedeklemeler
GenericName[pt]=Copias de Segurança com Versões
GenericName[it]=Backup con versione
GenericName[uk]=Резервні копії з версіями
GenericName[fi]=Versioidut varmuuskopiot
GenericName[el]=Aντίγραφα ασφαλείας βάσει εκδόσεων
GenericName[eo]=Ne forigi nomitajn savkopiojn
GenericName[ja]=バージョン管理されたバックアップ
GenericName[sv]=Versionsbaserade säkerhetskopior
