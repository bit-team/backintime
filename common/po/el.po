msgstr "Επίπεδο καταγραφής:"

#: qt/manageprofiles/tab_options.py:185
msgid "None"
msgstr "Κανένα"

#: qt/manageprofiles/tab_remove_retention.py:204
msgid "user manual"
msgstr "εγχειρίδιο χρήσης"

