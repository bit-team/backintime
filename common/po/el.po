#: qt/snapshotsdialog.py:96
msgid "Please set a diff command or press Cancel."
msgstr "Παρακαλώ ορίστε μια εντολή diff ή πατήστε Ακύρωση."

#: qt/snapshotsdialog.py:102
#, python-brace-format
msgid ""
"The command \"{cmd}\" cannot be found on this system. Please try something "
"else or press Cancel."
msgstr ""
"Η εντολή \"{cmd}\" δεν βρέθηκε σε αυτό το σύστημα. Παρακαλώ δοκιμάστε κάτι "
"άλλο ή πατήστε Ακύρωση."

#: qt/snapshotsdialog.py:110
#, python-brace-format
msgid "No parameters set for the diff command. Using default value \"{params}\"."
msgstr ""
"Δεν έχουν οριστεί παράμετροι για την εντολή diff. Χρησιμοποιείται η "
"προεπιλεγμένη τιμή \"{params}\"."

#: qt/snapshotsdialog.py:141 qt/timeline.py:44
msgid "Backups"
msgstr "Αντίγραφα ασφαλείας"

#: qt/snapshotsdialog.py:152
msgid "Differing backups only"
msgstr "Μόνο διαφορετικά αντίγραφα ασφαλείας"

#: qt/snapshotsdialog.py:161
msgid "List only backups that are equal to:"
msgstr "Παραθέστε μόνο αντίγραφα ασφαλείας που είναι ίσα με:"

#: qt/snapshotsdialog.py:173
msgid "Deep check (more accurate, but slow)"
msgstr "Έλεγχος σε βάθος (πιο ακριβής, αλλά αργός)"

#: qt/snapshotsdialog.py:194
msgid "Delete"
msgstr "Διαγραφή"

#: qt/snapshotsdialog.py:199
msgid "Select All"
msgstr "Επιλογή Όλων"

#: qt/snapshotsdialog.py:212
msgid "Compare"
msgstr "Σύγκριση"

#: qt/snapshotsdialog.py:227
msgid "Go To"
msgstr "Πήγαινε στο"

#: qt/snapshotsdialog.py:229
msgid "Options"
msgstr "Επιλογές"

#: qt/snapshotsdialog.py:392
msgid ""
"It is not possible to compare a backup to itself, as the comparison would be"
" redundant."
msgstr ""
"Δεν είναι δυνατόν να συγκρίνουμε ένα αντίγραφο ασφαλείας με τον εαυτό του, "
"καθώς η σύγκριση θα ήταν περιττή."

#: qt/snapshotsdialog.py:438
#, python-brace-format
msgid "Really delete {file_or_dir} in backup {backup_id}?"
msgstr ""
"Πραγματικά διαγράφεται το {file_or_dir} στο αντίγραφο ασφαλείας {backup_id};"

#: qt/snapshotsdialog.py:443
#, python-brace-format
msgid "Really delete {file_or_dir} in {count} backups?"
msgstr ""
"Πραγματικά διαγραφή του {file_or_dir} από {count} αντίγραφα ασφαλείας;"

#: qt/snapshotsdialog.py:446
msgid "WARNING: This cannot be revoked."
msgstr "ΠΡΟΕΙΔΟΠΟΙΗΣΗ: Αυτό δεν μπορεί να ανακληθεί."

#: qt/snapshotsdialog.py:463
#, python-brace-format
msgid "Exclude {path} from future backups?"
msgstr "Να εξαιρεθεί το {path} από μελλοντικά αντίγραφα ασφαλείας;"

#: qt/statusbar.py:85
msgid "Root mode"
msgstr "Λειτουργία root"

#: qt/statusbar.py:87
msgid ""
"Back In Time is currently running with root privileges (full system access)"
msgstr ""
"Το Back In Time εκτελείται αυτή τη στιγμή με προνόμια root (πλήρης πρόσβαση "
"στο σύστημα)"

#: qt/timeline.py:69
msgid "Today"
msgstr "Σήμερα"

#: qt/timeline.py:77
msgid "Yesterday"
msgstr "Εχθές"

#: qt/timeline.py:87
msgid "This week"
msgstr "Αυτή την εβδομάδα"

#: qt/timeline.py:95
msgid "Last week"
msgstr "Προηγούμενη εβδομάδα"

#: qt/timeline.py:270
msgid "This is NOT a backup but a live view of the local files."
msgstr ""
"Αυτό ΔΕΝ είναι αντίγραφο ασφαλείας, αλλά μια ζωντανή προβολή των τοπικών "
"αρχείων."

#: qt/timeline.py:275
#, python-brace-format
msgid "Last check {time}"
msgstr "Τελευταίος έλεγχος {time}"
