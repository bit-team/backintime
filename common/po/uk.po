#: common/sshsetupvalidator.py:124
#, python-brace-format
msgid "\"{tool}\" is not installed on the remote host."
msgstr "«{tool}» не встановлено на віддаленому сервері."

#: common/sshsetupvalidator.py:221
msgid "ssh-agent is not installed"
msgstr "ssh-agent не встановлено"

#: common/sshsetupvalidator.py:236
msgid "Unexpected response from ssh-agent."
msgstr "Неочікувана відповідь від ssh-agent."

#: common/sshsetupvalidator.py:252
msgid "Unexpected output from ssh-agent."
msgstr "Неочікуваний результат від ssh-agent."

#: common/sshsetupvalidator.py:253
