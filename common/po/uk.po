msgstr "Ключ SSH не завантажено в ssh-agent."

#: common/sshsetupvalidator.py:309
msgid "Failed to add SSH key."
msgstr "Не вдалося додати ключ SSH."

#: common/sshsetupvalidator.py:331
msgid "sshfs is not installed"
msgstr "sshfs не встановлено"

#: common/sshsetupvalidator.py:347
msgid "Unexpected response from sshfs."
msgstr "Неочікувана відповідь від sshfs."

#: common/sshsetupvalidator.py:373
#, python-brace-format
msgid "The SSH host \"{host}\" is not trusted yet."
msgstr "Сервер SSH «{host}» ще не є довіреним."

#: common/sshsetupvalidator.py:375
msgid "Please connect to the host manually once to confirm its fingerprint."
msgstr ""
"Підключіться до цього сервера вручну один раз, щоб підтвердити його "
"відбиток."

#: common/sshsetupvalidator.py:415
msgid "Could not write files to the remote host using rsync."
msgstr "Не вдалося записати файли на віддалений сервер за допомогою rsync."

#: common/sshsetupvalidator.py:469
msgid "Could not verify rsync hardlink support."
msgstr "Не вдалося перевірити підтримку жорстких посилань rsync."

#: common/sshsetupvalidator.py:498
msgid "Unexpected error while verifying rsync hardlink support."
msgstr ""
"Непередбачена помилка під час перевірки підтримки жорстких посилань rsync."

#: common/sshsetupvalidator.py:505
msgid "The remote file system does not support hardlinks."
msgstr "Віддалена файлова система не підтримує жорсткі посилання."

#: common/sshsetupvalidator.py:548
#, python-brace-format
msgid "Could not create remote backup directory: {path}"
msgstr "Не вдалося створити віддалений каталог для резервних копій: {path}"

#: common/sshtools.py:157
#, python-brace-format
msgid "Copy public SSH key \"{pubkey}\" to remote host \"{host}\"."
msgstr ""
"Копіювати публічний ключ SSH «{pubkey}» на віддалений сервер «{host}»."

#: common/sshtools.py:159
#, python-brace-format
msgid "Please enter a password for \"{user}\"."
msgstr "Будь ласка, введіть пароль для «{user}»."

#: common/tools.py:405
#, python-brace-format
msgid ""
"The destination filesystem for {path} is formatted with NTFS, which has "
"known incompatibilities with Unix-style filesystems."
msgstr ""
"Цільову файлову систему для {path} відформатовано у NTFS, яка має відому "
"несумісність із Unix-подібними файловими системами."

#: common/tools.py:438
#, python-brace-format
msgid "{path} is not a valid directory."
msgstr "{path} не є допустимим каталогом."

#: common/tools.py:456
msgid "Creation of following directory failed:"
msgstr "Не вдалося створити каталог:"

#: common/tools.py:458 common/tools.py:561
msgid "Write access may be restricted."
msgstr "Можливо, доступ на запис обмежений."

#: common/tools.py:505
#, python-brace-format
msgid ""
"Destination filesystem for {path} is formatted with FAT which doesn't "
"support hard-links. Please use a native GNU/Linux filesystem."
msgstr ""
"Цільову файлову систему для {path} відформатовано у FAT, яка не підтримує "
"жорсткі посилання. Використовуйте рідну файлову систему GNU/Linux."

#: common/tools.py:516
#, python-brace-format
msgid ""
"Destination filesystem for {path} is a share mounted via SMB. Please make "
"sure the remote SMB server supports symlinks or activate \"{copyLinks}\" in "
"\"{expertOptions}\"."
msgstr ""
"Цільова файлова система для {path} — змонтований спільний SMB-ресурс. "
"Переконайтеся, що віддалений SMB-сервер підтримує символьні посилання, або "
"активуйте «{copyLinks}» в «{expertOptions}»."

#: common/tools.py:520
msgid "Copy links (dereference symbolic links)"
msgstr "Копіювати посилання (слідувати за символьними посиланнями)"

#: common/tools.py:521
msgid "Expert Options"
msgstr "Розширені налаштування"

#: common/tools.py:525
#, python-brace-format
msgid ""
"Destination filesystem for {path} is a share mounted via sshfs. Sshfs "
"doesn't support hard-links. Please use mode \"SSH\" instead."
msgstr ""
"Цільова файлова система для {path} — змонтований спільний sshfs-ресурс. "
"Sshfs не підтримує жорсткі посилання. Будь ласка, використовуйте режим "
"«SSH»."

