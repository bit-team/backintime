#: qt/restoreconfigdialog.py:71
msgid "Import configuration"
msgstr "Імпортувати конфігурацію"

#: qt/restoreconfigdialog.py:102
msgid "No directory selected"
msgstr "Не вибрано каталог"

#: qt/restoreconfigdialog.py:151 qt/restoreconfigdialog.py:227
msgid "Searching…"
msgstr "Пошук…"

#: qt/restoreconfigdialog.py:204
#, python-brace-format
msgid ""
"Select the backup directory from which the configuration file should be "
"imported. The path may look like: {samplePath}"
msgstr ""
"Виберіть каталог резервних копій, з якого слід імпортувати файл "
"конфігурації. Шлях може мати такий вигляд: {samplePath}"

#: qt/restoreconfigdialog.py:209
msgid ""
"If the directory is located on an external or remote drive, it must be "
"manually mounted beforehand."
msgstr ""
"Якщо це каталог на зовнішньому або віддаленому диску, його потрібно "
"попередньо змонтувати вручну."

#: qt/restoreconfigdialog.py:230
msgid "Scan again"
msgstr "Сканувати ще раз"

#: qt/restoreconfigdialog.py:249
msgid "Show hidden directories"
msgstr "Показати приховані каталоги"

#: qt/restoreconfigdialog.py:251
msgid "Show/hide hidden directories (Ctrl+H)"
msgstr "Показати/сховати приховані каталоги (Ctrl+H)"

#: qt/restoreconfigdialog.py:298
msgid "No config found in this directory."
msgstr "Не знайдено конфігурації в цьому каталозі."

#: qt/restoreconfigdialog.py:359
msgid "Search complete."
msgstr "Пошук завершено."

#: qt/restoredialog.py:58
msgid "Show full Log"
msgstr "Показати повний журнал"

#: qt/shutdowndlg.py:28
msgid "Countdown to Shutdown"
msgstr "Відлік до вимкнення"

#: qt/shutdowndlg.py:29
msgid "The backup has finished."
msgstr "Резервування завершено."

#: qt/shutdowndlg.py:36
msgid "Cancel Shutdown"
msgstr "Скасувати вимкнення"

#: qt/shutdowndlg.py:37
msgid "Shutdown Now"
msgstr "Вимкнути зараз"

#: qt/shutdowndlg.py:69
#, python-brace-format
msgid "The system will shut down in {n} second."
msgid_plural "The system will shut down in {n} seconds."
msgstr[0] "Система завершить роботу через {n} секунду."
msgstr[1] "Система завершить роботу через {n} секунди."
msgstr[2] "Система завершить роботу через {n} секунд."

#: qt/snapshotsdialog.py:62
msgid "Options about comparing backups"
msgstr "Параметри порівняння резервних копій"

#: qt/snapshotsdialog.py:74
msgid "Parameters:"
msgstr "Параметри:"

#: qt/snapshotsdialog.py:79
msgid "Use %1 and %2 for path parameters"
msgstr "Використовуйте %1 та %2 як параметри шляху"

#: qt/snapshotsdialog.py:96
msgid "Please set a diff command or press Cancel."
msgstr "Задайте команду diff або натисніть «Скасувати»."

#: qt/snapshotsdialog.py:102
#, python-brace-format
msgid ""
"The command \"{cmd}\" cannot be found on this system. Please try something "
"else or press Cancel."
msgstr ""
"Не вдається знайти команду «{cmd}» у цій системі. Будь ласка, спробуйте щось"
" інше або натисніть «Скасувати»."

#: qt/snapshotsdialog.py:110
#, python-brace-format
msgid "No parameters set for the diff command. Using default value \"{params}\"."
msgstr ""
"Для команди diff не задано жодних параметрів. Використовується значення за "
"замовчуванням «{params}»."

#: qt/snapshotsdialog.py:140 qt/timeline.py:119
msgid "Backups"
msgstr "Резервні копії"

#: qt/snapshotsdialog.py:151
msgid "Differing backups only"
msgstr "Тільки копії, що відрізняються"

#: qt/snapshotsdialog.py:160
msgid "List only backups that are equal to:"
msgstr "Показати лише копії, однакові з:"

#: qt/snapshotsdialog.py:172
msgid "Deep check (more accurate, but slow)"
msgstr "Глибока перевірка (точніша, але повільна)"

#: qt/snapshotsdialog.py:193
msgid "Delete"
msgstr "Видалити"

#: qt/snapshotsdialog.py:198
msgid "Select All"
msgstr "Вибрати все"

#: qt/snapshotsdialog.py:218
msgid "Compare"
msgstr "Порівняти"

#: qt/snapshotsdialog.py:233
msgid "Go To"
msgstr "Перейти до"

#: qt/snapshotsdialog.py:235
msgid "Options"
msgstr "Налаштування"

#: qt/snapshotsdialog.py:417
msgid ""
"It is not possible to compare a backup to itself, as the comparison would be"
" redundant."
msgstr ""
"Неможливо порівняти резервну копію саму з собою, таке порівняння було б "
"зайвим."

#: qt/snapshotsdialog.py:467
#, python-brace-format
msgid "Really delete {file_or_dir} in backup {backup_id}?"
msgstr "Справді видалити {file_or_dir} з резервної копії {backup_id}?"

#: qt/snapshotsdialog.py:472
#, python-brace-format
msgid "Really delete {file_or_dir} in {count} backups?"
msgstr "Справді видалити {file_or_dir} з {count} резервних копій?"

#: qt/snapshotsdialog.py:475
msgid "WARNING: This cannot be revoked."
msgstr "УВАГА: це не можна буде скасувати."

#: qt/snapshotsdialog.py:492
#, python-brace-format
msgid "Exclude {path} from future backups?"
msgstr "Виключити {path} з майбутніх резервних копій?"

#: qt/statusbar.py:85
msgid "Root mode"
msgstr "Режим root"

#: qt/statusbar.py:87
msgid ""
"Back In Time is currently running with root privileges (full system access)"
msgstr "Back In Time наразі працює з правами root (повний доступ до системи)"

