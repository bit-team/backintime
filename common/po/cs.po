msgid_plural "Waiting {n} seconds."
msgstr[0] "Čeká se {n} sekundu."
msgstr[1] "Čeká se {n} sekundy."
msgstr[2] "Čeká se {n} sekund."

#: common/snapshots.py:1005
#, python-brace-format
msgid "Failed to create backup {snapshot_id}."
msgstr "Nepodařilo se vytvořit zálohu {snapshot_id}."

#: common/snapshots.py:1037
msgid "Please be patient. Finalizing…"
msgstr "Chvíli strpení. Dokončování…"

#: common/snapshots.py:1163
msgid "Can't create directory."
msgstr "Složku se nedaří vytvořit."

#: common/snapshots.py:1180
