#: common/tools.py:382
#, python-brace-format
msgid ""
"The destination filesystem for {path} is formatted with NTFS, which has "
"known incompatibilities with Unix-style filesystems."
msgstr ""
"Cílový souborový systém pro {path} je typu NTFS a ten má známé "
"nekompatibility se způsobem, jakým jsou soubory ukládány na unixových "
"souborových systémech."

