msgstr "Podrobnosti se dozvíte spuštěním „man rsync“"

#: common/snapshots.py:1545
msgid ""
"Negative rsync exit codes are signal numbers, see 'kill -l' and 'man kill'"
msgstr ""
"Záporné návratové kódy z rsync jsou čísly signálů – viz příkazy „kill -l“ a "
"„man kill“"

#: common/snapshots.py:1566
msgid "Nothing changed, no new backup necessary"
msgstr "Nic se nezměnilo, není tedy třeba vytvářet novou zálohu"

#: common/snapshots.py:1611
#, python-brace-format
