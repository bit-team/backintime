msgstr "… pokud volného místa zbývá méně než"

#: qt/manageprofiles/tab_remove_retention.py:386
msgid "… the free inodes are less than"
msgstr ""
"… pokud z počtu složek a souborů, které lze na souborovém systému vytvořit "
"(inode), zbývá méně než"

#: qt/manageprofiles/tab_remove_retention.py:395
