#, python-brace-format
msgid "Unable to mount {sshfs}"
msgstr "Nedaří se připojit (mount) {sshfs}"

#: common/sshtools.py:306
msgid "ssh-agent not found. Please ensure it is installed."
msgstr "ssh-agent nenalezen. Ověřte, zda je nainstalovaný."

#: common/sshtools.py:489
msgid ""
"Could not unlock ssh private key. Wrong password or password not available "
"for cron."
msgstr ""
"Nedaří se odemknout soukromý ssh klíč. Heslo je buď chybně zadané nebo není "
"k dispozici plánovači cron."

#: common/sshtools.py:721
msgid "Remote path exists but is not a directory."
msgstr "Vzdálené umístění existuje, ale není to složka."

#: common/sshtools.py:726
msgid "Remote path is not writable."
msgstr "Do vzdáleného umístění nelze zapisovat."

#: common/sshtools.py:731
msgid "Remote path is not executable."
msgstr ""
"Vzdálené umístění nemá nastaveno oprávnění ke spouštění (tj. nelze do něho "
"vstoupit)."

#: common/sshtools.py:736
msgid "Couldn't create remote path."
msgstr "Vzdálené umístění se nedaří vytvořit."

#: common/sshtools.py:1022
#, python-brace-format
msgid "Remote host {host} doesn't support {command}"
msgstr "Vzdálený stroj {host} nepodporuje {command}"

#: common/sshtools.py:1026
#, python-brace-format
msgid "Checking commands on host {host} returned unknown error"
msgstr "Kontrolní příkazy na stroji {host} vrátily neznámou chybu"

#: common/sshtools.py:1044
#, python-brace-format
msgid "Remote host {host} doesn't support hardlinks"
msgstr "Na vzdáleném stroji {host} nejsou podporovány pevné odkazy (hardlink)"

#: common/sshtools.py:1206
#, python-brace-format
msgid "Copy public ssh-key \"{pubkey}\" to remote host \"{host}\"."
msgstr "Zkopírovat veřejný ssh klíč „{pubkey}“ na vzdálený stroj „{host}“."

#: common/sshtools.py:1208
#, python-brace-format
msgid "Please enter a password for \"{user}\"."
msgstr "Vyplňte heslo pro „{user}“."

#: common/tools.py:382
#, python-brace-format
msgid ""
"The destination filesystem for {path} is formatted with NTFS, which has "
"known incompatibilities with Unix-style filesystems."
msgstr ""
"Cílový souborový systém pro {path} je typu NTFS a ten má známé "
"nekompatibility se způsobem, jakým jsou soubory ukládány na unixových "
"souborových systémech."

#: common/tools.py:414
#, python-brace-format
msgid "{path} is not a valid directory."
msgstr "{path} není platnou složkou."

#: common/tools.py:428
msgid "Creation of following directory failed:"
msgstr "Vytváření následující složky se nezdařilo:"

#: common/tools.py:430 common/tools.py:527
msgid "Write access may be restricted."
msgstr "Může se stát, že přístup pro zápis bude omezený."

#: common/tools.py:471
#, python-brace-format
msgid ""
"Destination filesystem for {path} is formatted with FAT which doesn't "
"support hard-links. Please use a native GNU/Linux filesystem."
msgstr ""
"Cílový souborový systém pro {path} je typu FAT a ten nepodporuje pevné "
"odkazy (hardlink). Použijte namísto něj nějaký běžný linuxový souborový "
"systém."

#: common/tools.py:482
#, python-brace-format
msgid ""
"Destination filesystem for {path} is a share mounted via SMB. Please make "
"sure the remote SMB server supports symlinks or activate \"{copyLinks}\" in "
"\"{expertOptions}\"."
msgstr ""
"Cílový souborový systém pro {path} je SMB síťové sdílení. Ověřte, že "
"vzdálený SMB server podporuje symbolické odkazy (symlink), případně v "
"„{expertOptions}“ zapněte „{copyLinks}“."

#: common/tools.py:486
msgid "Copy links (dereference symbolic links)"
msgstr ""
"Zrušit odkazy (použít jen jejich názvy a zkopírovat pod nimi data z předtím "
"odkazovaných souborů)"

#: common/tools.py:487
msgid "Expert Options"
msgstr "Pokročilé předvolby"

#: common/tools.py:491
#, python-brace-format
msgid ""
"Destination filesystem for {path} is a share mounted via sshfs. Sshfs "
"doesn't support hard-links. Please use mode \"SSH\" instead."
msgstr ""
"Cílový souborový systém pro {path} je sdílení připojené přes sshfs. To "
"nepodporuje pevné odkazy (hardlink). Použijte namísto toho přímo režim „Přes"
" SSH."

#: common/tools.py:525
