msgid ""
"The years are counted as calendar years starting with the current year."
msgstr "Roky jsou počítány jako kalendářní a začíná se stávajícím rokem."

#: qt/manageprofiles/tab_remove_retention.py:372
msgid "Keep the last backup for each year for"
msgstr "Ponechat poslední zálohu z každého roku za"

#: qt/manageprofiles/tab_remove_retention.py:374
msgid "all years."
msgstr "za všechna leta."

