msgstr "Hotovo"

#: common/snapshots.py:749
msgid ""
"The following entries from the include list have no corresponding file or "
"directory in the backup source:"
msgstr ""
"Následující položky ze seznamu pro obsažení nemají odpovídající soubor nebo "
"složku ve zdroji zálohy:"

#: common/snapshots.py:812
msgid "Deferring backup while on battery"
msgstr "Zálohování odloženo po dobu napájení z akumulátoru"

#: common/snapshots.py:931 qt/app.py:377
msgid "Can't find backup directory."
msgstr "Nepodařilo se najít složku se zálohami."

