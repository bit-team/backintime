#: qt/manageprofiles/tab_exclude.py:63
#, python-brace-format
msgid ""
"{BOLD}Info{ENDBOLD}: In 'SSH encrypted' mode, only single or double "
"asterisks are functional (e.g. {example2}). Other types of wildcards and "
"patterns will be ignored (e.g. {example1}). Filenames are unpredictable in "
"this mode."
msgstr ""
"{BOLD}Pro informaci{ENDBOLD}: V režimu „Přes SSH (v šifrované podobě)“ "
"funguje pouze jedna nebo dvě hvězdičky (např. {example2}). Ostatní typy "
"zástupných vyjádření a vzorů budou ignorovány (např. {example1}) Názvy "
"souborů se totiž v tomto režimu kvůli EncFS šifrování nedají předvídat."

