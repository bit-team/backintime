msgstr "Vytváření zálohy"

#: common/snapshots.py:1517
msgid "Success"
msgstr "Úspěch"

#: common/snapshots.py:1520
msgid "Partial transfer due to error"
msgstr "Přenos jen částečně úspěšný kvůli chybě"

#: common/snapshots.py:1521
msgid "Partial transfer due to vanished source files (see 'man rsync')"
msgstr "Přenesena je část kvůli zmizelým zdrojovým souborům (viz „man rsync“)"

