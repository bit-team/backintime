msgid "Backup replaced files on restore"
msgstr "Zazálohovat soubory, které by byly při procesu obnovování nahrazeny"

#: qt/manageprofiles/tab_options.py:78
msgid "Continue on errors (keep incomplete backups)"
msgstr "Pokračovat i v případě výskytu chyb (zachovat i neúplné zálohy)"

