msgid "Keep all backups for the last"
msgstr "Păstrează toate copiile de rezervă pentru ultima(ultimele)"

#: qt/manageprofiles/tab_remove_retention.py:328
#: qt/manageprofiles/tab_remove_retention.py:340
msgid "day(s)."
msgstr "zi(zile)."

