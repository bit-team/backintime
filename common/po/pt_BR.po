#: qt/manageprofiles/tab_options.py:39
msgid "Enable notifications"
msgstr "Ativar notificações"

#: qt/manageprofiles/tab_options.py:43
msgid "Disable backups when on battery"
msgstr "Desativar backup quando estiver usando a bateria"

#: qt/manageprofiles/tab_options.py:49
msgid "Power status not available from system"
msgstr "O nível de bateria não está disponível pelo sistema operacional"

#: qt/manageprofiles/tab_options.py:52
msgid "Run only one backup at a time"
msgstr "Executar apenas um backup por vez"

#: qt/manageprofiles/tab_options.py:56
msgid ""
"Other backups will be blocked until the current backup is completed. This is"
" a global setting, meaning it will affect all profiles for this user. "
"However, it must also be activated for all other users."
msgstr ""
"Outros backups serão bloqueados até que o backup atual seja concluído. Esta "
"é uma configuração global, portanto, afetará todos os perfis deste usuário. "
"Porém, precisa ser ativada para todos os outros usuários."

#: qt/manageprofiles/tab_options.py:63
msgid "Backup replaced files on restore"
msgstr "O backup substituiu arquivos na restauração"

#: qt/manageprofiles/tab_options.py:78
msgid "Continue on errors (keep incomplete backups)"
msgstr "Continuar em caso de erros (manter backups incompletos)"

#: qt/manageprofiles/tab_options.py:82
msgid "Use checksum to detect changes"
msgstr ""
"Utilizar a verificação da integridade dos arquivos (checksum) para detectar "
"alterações"

#: qt/manageprofiles/tab_options.py:86
msgid "Create a new backup whether there were changes or not."
msgstr "Criar um novo backup independentemente de terem ocorrido alterações."

#: qt/manageprofiles/tab_options.py:95
msgid "Warn if the free disk space falls below"
msgstr "Notificar se o espaço livre no disco ficar abaixo"

#: qt/manageprofiles/tab_options.py:101
msgid ""
"Shows a warning when free space on the backup destination disk is less than "
"the specified value."
msgstr ""
"Exibir uma notificação quando o espaço livre no local de destino do backup "
"for menor do que o valor especificado."

#: qt/manageprofiles/tab_options.py:103
msgid ""
"If the Remove & Retention policy is enabled and old backups are removed "
"based on available free space, this value cannot be lower than the value set"
" in the policy."
msgstr ""
"Se a política da remoção e da retenção estiver ativada e os backups antigos "
"forem removidas com base no espaço livre disponível, este valor não poderá "
"ser inferior ao valor que foi definido na política."

#: qt/manageprofiles/tab_options.py:122
msgid "Log Level:"
msgstr "Nível do registro de alterações (log):"

#: qt/manageprofiles/tab_options.py:185
msgid "None"
msgstr "Nenhum"

#: qt/manageprofiles/tab_remove_retention.py:206
msgid "user manual"
msgstr "manual do usuário"

#: qt/manageprofiles/tab_remove_retention.py:208
#, python-brace-format
msgid ""
"The following rules are processed from top to bottom. Later rules override "
"earlier ones. See the {manual_link} for details and examples."
msgstr ""
"As seguintes regras são processadas de cima para baixo. As regras "
"posteriores substituem as anteriores. Por favor, consulte o {manual_link} "
"para obter mais informações e exemplos."

#: qt/manageprofiles/tab_remove_retention.py:223
msgid "Open user manual in browser."
msgstr "Abrir o manual do usuário no navegador."

#: qt/manageprofiles/tab_remove_retention.py:237
msgid "Keep the most recent backup."
msgstr "Manter o backup mais recente."

#: qt/manageprofiles/tab_remove_retention.py:241
msgid "The most up-to-date backup is kept under all circumstances."
msgstr "O backup mais recente é mantido sob todas as circunstancias."

#: qt/manageprofiles/tab_remove_retention.py:243
msgid "That behavior cannot be changed."
msgstr "Este comportamento não pode ser alterado."

#: qt/manageprofiles/tab_remove_retention.py:256
msgid "Keep named backups."
msgstr "Manter os backups nomeados."

#: qt/manageprofiles/tab_remove_retention.py:259
msgid ""
"Backups that have been given a name, in addition to the usual timestamp, "
"will be retained under all circumstances and will not be removed."
msgstr ""
"Os backups que receberam um nome, além do registro da data e da hora usual, "
"serão mantidos sob todas as circunstancias e não serão removidos."

#: qt/manageprofiles/tab_remove_retention.py:274
msgid "Year(s)"
msgstr "Ano(s)"

#: qt/manageprofiles/tab_remove_retention.py:279
msgid "Remove backups older than"
msgstr "Remover backups mais antigos que"

#: qt/manageprofiles/tab_remove_retention.py:285
msgid "Full days. Current day is ignored."
msgstr "Dias completos. O dia atual é ignorado."

#: qt/manageprofiles/tab_remove_retention.py:287
msgid "Calendar weeks with Monday as first day. Current week is ignored."
msgstr ""
"Os dias da semana do calendário começam na segunda-feira. A semana atual é "
"ignorada."

#: qt/manageprofiles/tab_remove_retention.py:290
msgid "12 months periods. Current month is ignored."
msgstr "Períodos de 12 meses. Mês atual é ignorado."

#: qt/manageprofiles/tab_remove_retention.py:306
msgid "Retention policy"
msgstr "Política de retenção"

#: qt/manageprofiles/tab_remove_retention.py:311
msgid "Run in background on remote host."
msgstr "Executar em segundo plano no host remoto."

#: qt/manageprofiles/tab_remove_retention.py:314
msgid ""
"The retention policy will be executed directly on the remote machine, not "
"locally. The commands \"bash\", \"screen\", and \"flock\" must be installed "
"and available on that remote machine."
msgstr ""
"A política de retenção será executada diretamente na máquina remota e não na"
" máquina local. Os comandos do \"bash\", \"screen\" e \"flock\" devem estar "
"instalados e disponíveis na máquina remota."

#: qt/manageprofiles/tab_remove_retention.py:318
msgid "If selected, Back In Time will first test the remote machine."
msgstr ""
"Se esta opção for selecionada, o Back In Time irá primeiro testar a máquina "
"remota."

#: qt/manageprofiles/tab_remove_retention.py:322
msgid "The days are counted starting from today."
msgstr "Os dias são contados a partir de hoje."

#: qt/manageprofiles/tab_remove_retention.py:323
msgid "Keep all backups for the last"
msgstr "Manter todos os backups dos últimos"

#: qt/manageprofiles/tab_remove_retention.py:328
#: qt/manageprofiles/tab_remove_retention.py:340
msgid "day(s)."
msgstr "dia(s)."

#: qt/manageprofiles/tab_remove_retention.py:335
msgid "Keep the last backup for each day for the last"
msgstr "Manter o último backup de cada dia dos últimos"

#: qt/manageprofiles/tab_remove_retention.py:345
msgid ""
"The weeks are counted starting from the current running week. A week starts "
"on Monday."
msgstr ""
"As semanas são contadas a partir da semana atual. Uma semana começa na "
"segunda-feira."

#: qt/manageprofiles/tab_remove_retention.py:348
msgid "Keep the last backup for each week for the last"
msgstr "Manter o último backup de cada semana das últimas"

#: qt/manageprofiles/tab_remove_retention.py:353
msgid "week(s)."
msgstr "semana(s)."

#: qt/manageprofiles/tab_remove_retention.py:358
msgid ""
"The months are counted as calendar months starting with the current month."
msgstr ""
"Os meses são contados como meses do calendário começando pelo mês atual."

#: qt/manageprofiles/tab_remove_retention.py:361
msgid "Keep the last backup for each month for the last"
msgstr "Manter o último backup de cada mês dos últimos"

#: qt/manageprofiles/tab_remove_retention.py:366
msgid "month(s)."
msgstr "mês(es)."

#: qt/manageprofiles/tab_remove_retention.py:371
msgid ""
"The years are counted as calendar years starting with the current year."
msgstr ""
"Os anos são contados como anos do calendário começando pelo ano atual."

#: qt/manageprofiles/tab_remove_retention.py:373
msgid "Keep the last backup for each year for"
msgstr "Manter o último backup de cada ano por"

#: qt/manageprofiles/tab_remove_retention.py:375
msgid "all years."
msgstr "todos os anos."

#: qt/manageprofiles/tab_remove_retention.py:390
msgid "… the free space is less than"
msgstr "... o espaço livre é menor que"

#: qt/manageprofiles/tab_remove_retention.py:395
msgid "… the free inodes are less than"
msgstr "... a quantidade de inodes livres é menor que"

#: qt/manageprofiles/tab_remove_retention.py:404
