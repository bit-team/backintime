#: qt/manageprofiles/tab_exclude.py:63
#, python-brace-format
msgid ""
"{BOLD}Info{ENDBOLD}: In 'SSH encrypted' mode, only single or double "
"asterisks are functional (e.g. {example2}). Other types of wildcards and "
"patterns will be ignored (e.g. {example1}). Filenames are unpredictable in "
"this mode."
msgstr ""
"{BOLD}Informacje{ENDBOLD}: w trybie „Zaszyfrowany SSH” działają tylko "
"pojedyncze lub podwójne gwiazdki (np. {example2}). Inne typy symboli "
"wieloznacznych i wzorców będą ignorowane (np. {example1}). Nazwy plików "
"w tym trybie są nieprzewidywalne."

