"It is not possible to compare a backup to itself, as the comparison would be"
" redundant."
msgstr ""
"Nie można porównywać kopii zapasowej z nią samą, ponieważ porównanie takie "
"byłoby zbędne."

#: qt/snapshotsdialog.py:467
#, python-brace-format
msgid "Really delete {file_or_dir} in backup {backup_id}?"
msgstr "Czy na pewno usunąć {file_or_dir} z kopii zapasowej {backup_id}?"

#: qt/snapshotsdialog.py:472
#, python-brace-format
msgid "Really delete {file_or_dir} in {count} backups?"
msgstr "Czy na pewno usunąć {file_or_dir} w {count} kopiach zapasowych?"

#: qt/snapshotsdialog.py:475
msgid "WARNING: This cannot be revoked."
msgstr "OSTRZEŻENIE: nie można tego cofnąć."

#: qt/snapshotsdialog.py:492
#, python-brace-format
msgid "Exclude {path} from future backups?"
msgstr "Wykluczyć {path} z przyszłych kopii zapasowych?"

