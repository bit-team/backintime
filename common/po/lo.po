msgstr "ໜ້າ man: {man_page_name}"

#: qt/restoreconfigdialog.py:76
msgid "Import configuration"
msgstr "ນຳເຂົ້າການກຳນົດຄ່າ"

#: qt/restoreconfigdialog.py:107
msgid "No directory selected"
msgstr "ບໍ່ໄດ້ເລືອກໄດເຣັກທໍຣີ"

#: qt/restoreconfigdialog.py:156 qt/restoreconfigdialog.py:231
msgid "Searching…"
msgstr "ກຳລັງຄົ້ນຫາ…"

#: qt/restoreconfigdialog.py:208
#, python-brace-format
msgid ""
"Select the backup directory from which the configuration file should be "
"imported. The path may look like: {samplePath}"
msgstr ""
"ເລືອກໄດເຣັກທໍຣີສຳຮອງຂໍ້ມູນທີ່ຈະນຳເຂົ້າໄຟລ໌ກຳນົດຄ່າ. ເສັ້ນທາງອາດຈະເປັນຄື: "
"{samplePath}"

#: qt/restoreconfigdialog.py:213
msgid ""
"If the directory is located on an external or remote drive, it must be "
"manually mounted beforehand."
msgstr ""
"ຫາກໄດເຣັກທໍຣີຢູ່ໃນໄດຣຟ໌ພາຍນອກ ຫຼື ເຄື່ອງປາຍທາງ, ມັນຕ້ອງຖືກເຊື່ອມຕໍ່ (mount) "
"ດ້ວຍຕົນເອງກ່ອນ."

#: qt/restoreconfigdialog.py:234
msgid "Scan again"
msgstr "ສະແກນອີກຄັ້ງ"

#: qt/restoreconfigdialog.py:253
msgid "Show hidden directories"
msgstr "ສະແດງໄດເຣັກທໍຣີທີ່ຊ່ອນຢູ່"

#: qt/restoreconfigdialog.py:255
msgid "Show/hide hidden directories (Ctrl+H)"
msgstr "ສະແດງ/ຊ່ອນ ໄດເຣັກທໍຣີທີ່ຊ່ອນຢູ່ (Ctrl+H)"

#: qt/restoreconfigdialog.py:308
msgid "No config found in this directory."
msgstr "ບໍ່ພົບການກຳນົດຄ່າໃນໄດເຣັກທໍຣີນີ້."

#: qt/restoreconfigdialog.py:373
msgid "Search complete."
msgstr "ຄົ້ນຫາສຳເລັດ."

#: qt/restoredialog.py:60
msgid "Show full Log"
msgstr "ສະແດງບັນທຶກເຕັມ"

#: qt/restoredialog.py:123
msgid ""
"The restore is still running. The window cannot be closed until it is "
"finished."
msgstr "ການກູ້ຄືນຍັງຄົງດຳເນີນຢູ່. ບໍ່ສາມາດປິດໜ້າຈໍນີ້ໄດ້ຈົນກວ່າມັນຈະສຳເລັດ."

#: qt/shutdowndlg.py:28
msgid "Countdown to Shutdown"
msgstr "ນັບຖອຍຫຼັງເພື່ອປິດເຄື່ອງ"

#: qt/shutdowndlg.py:29
msgid "The backup has finished."
msgstr "ການສຳຮອງຂໍ້ມູນສຳເລັດແລ້ວ."

#: qt/shutdowndlg.py:36
msgid "Cancel Shutdown"
msgstr "ຍົກເລີກການປິດເຄື່ອງ"

#: qt/shutdowndlg.py:37
msgid "Shutdown Now"
msgstr "ປິດເຄື່ອງດຽວນີ້"

#: qt/shutdowndlg.py:69
#, python-brace-format
msgid "The system will shut down in {n} second."
msgid_plural "The system will shut down in {n} seconds."
msgstr[0] "ລະບົບຈະປິດເຄື່ອງໃນອີກ {n} ວິນາທີ."

#: qt/snapshotsdialog.py:62
msgid "Options about comparing backups"
msgstr "ຕົວເລືອກກ່ຽວກັບການປຽບທຽບການສຳຮອງຂໍ້ມູນ"

#: qt/snapshotsdialog.py:74
msgid "Parameters:"
msgstr "ພາຣາມິເຕີ:"

#: qt/snapshotsdialog.py:79
msgid "Use %1 and %2 for path parameters"
msgstr "ໃຊ້ %1 ແລະ %2 ສຳລັບພາຣາມິເຕີເສັ້ນທາງ"

#: qt/snapshotsdialog.py:96
msgid "Please set a diff command or press Cancel."
msgstr "ກະລຸນາຕັ້ງຄ່າຄຳສັ່ງ diff ຫຼື ກົດ ຍົກເລີກ."

#: qt/snapshotsdialog.py:102
#, python-brace-format
msgid ""
"The command \"{cmd}\" cannot be found on this system. Please try something "
"else or press Cancel."
msgstr "ບໍ່ພົບຄຳສັ່ງ \"{cmd}\" ໃນລະບົບນີ້. ກະລຸນາລອງຄຳສັ່ງອື່ນ ຫຼື ກົດ ຍົກເລີກ."

#: qt/snapshotsdialog.py:110
#, python-brace-format
msgid "No parameters set for the diff command. Using default value \"{params}\"."
msgstr "ບໍ່ໄດ້ຕັ້ງຄ່າພາຣາມິເຕີສຳລັບຄຳສັ່ງ diff. ຈະໃຊ້ຄ່າເລີ່ມຕົ້ນ \"{params}\"."

#: qt/snapshotsdialog.py:140 qt/timeline.py:118
msgid "Backups"
msgstr "ການສຳຮອງຂໍ້ມູນ"

#: qt/snapshotsdialog.py:151
msgid "Differing backups only"
msgstr "ສະແດງສະເພາະການສຳຮອງຂໍ້ມູນທີ່ຕ່າງກັນ"

#: qt/snapshotsdialog.py:160
msgid "List only backups that are equal to:"
msgstr "ສະແດງສະເພາະການສຳຮອງຂໍ້ມູນທີ່ຄືກັນກັບ:"

#: qt/snapshotsdialog.py:172
msgid "Deep check (more accurate, but slow)"
msgstr "ກວດສອບແບບລະອຽດ (ຖືກຕ້ອງກວ່າ, ແຕ່ຊ້າ)"

#: qt/snapshotsdialog.py:193
msgid "Delete"
msgstr "ລຶບ"

#: qt/snapshotsdialog.py:198
msgid "Select All"
msgstr "ເລືອກທັງໝົດ"

#: qt/snapshotsdialog.py:218
msgid "Compare"
msgstr "ປຽບທຽບ"

#: qt/snapshotsdialog.py:233
msgid "Go To"
msgstr "ໄປຍັງ"

#: qt/snapshotsdialog.py:235
msgid "Options"
msgstr "ຕົວເລືອກ"

#: qt/snapshotsdialog.py:417
msgid ""
"It is not possible to compare a backup to itself, as the comparison would be"
" redundant."
msgstr ""
"ບໍ່ສາມາດປຽບທຽບການສຳຮອງຂໍ້ມູນກັບຕົວມັນເອງໄດ້ ເພາະມັນເປັນການປຽບທຽບທີ່ຊໍ້າຊ້ອນ."

#: qt/snapshotsdialog.py:467
#, python-brace-format
msgid "Really delete {file_or_dir} in backup {backup_id}?"
msgstr "ຕ້ອງການລຶບ {file_or_dir} ໃນການສຳຮອງຂໍ້ມູນ {backup_id} ແທ້ຫຼືບໍ່?"

#: qt/snapshotsdialog.py:472
#, python-brace-format
msgid "Really delete {file_or_dir} in {count} backups?"
msgstr "ຕ້ອງການລຶບ {file_or_dir} ໃນ {count} ການສຳຮອງຂໍ້ມູນແທ້ຫຼືບໍ່?"

#: qt/snapshotsdialog.py:475
msgid "WARNING: This cannot be revoked."
msgstr "ຄຳເຕືອນ: ສິ່ງນີ້ບໍ່ສາມາດຍົກເລີກ ຫຼື ກູ້ຄືນໄດ້."

#: qt/snapshotsdialog.py:492
#, python-brace-format
msgid "Exclude {path} from future backups?"
msgstr "ຍົກເວັ້ນ {path} ຈາກການສຳຮອງຂໍ້ມູນໃນອະນາຄົດຫຼືບໍ່?"

