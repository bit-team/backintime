msgid "Keep the last backup for each year for"
msgstr "Mantendu urteko babeskopia bana"

#: qt/manageprofiles/tab_remove_retention.py:374
msgid "all years."
msgstr "urte guztiak."

#: qt/manageprofiles/tab_remove_retention.py:389
