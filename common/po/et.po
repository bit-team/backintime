msgid "Couldn't create remote path."
msgstr "Ei saa luua välisseadmes asuvat kausta."

#: common/sshtools.py:1022
#, python-brace-format
msgid "Remote host {host} doesn't support {command}"
msgstr "Väline seade „{host}“ ei toeta käsku „{command}“"

