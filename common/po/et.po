msgstr ""
"Rsynci püsilinkide toe olemasolu kontrollimisel tekkis ootamatu/teadmata "
"viga."

#: common/sshsetupvalidator.py:505
msgid "The remote file system does not support hardlinks."
msgstr "Välise seadme failisüsteem ei toeta püsilinke."

#: common/sshsetupvalidator.py:548
#, python-brace-format
