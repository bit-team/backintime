        <mxCell id="Kyt2Ybz1KD1fWm82J71v-1" value="&lt;p&gt;The rules are applied in descending order, as shown here.&lt;/p&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;" vertex="1" parent="x8gMyu6OwGuHP-ef9QG5-16">
