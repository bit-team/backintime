        <mxCell id="Kyt2Ybz1KD1fWm82J71v-6" value="&lt;p&gt;Complete weeks are counted, starting with the previous week (date from-to).&amp;nbsp;The most recent backup of a week will be kept if multiple backups are available.&lt;/p&gt;" style="html=1;rounded=1;strokeColor=#DFE1E5;fontSize=14;align=center;shadow=1;arcSize=1;whiteSpace=wrap;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=0;spacing=0;labelBackgroundColor=#FEF0C4;textShadow=1;labelBorderColor=default;" vertex="1" parent="x8gMyu6OwGuHP-ef9QG5-16">
